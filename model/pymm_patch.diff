index 63886fc..dc1c5f2 100644
--- a/Include/cpython/lock.h
+++ b/Include/cpython/lock.h
@@ -59,9 +59,15 @@ static inline void
 _PyMutex_Unlock(PyMutex *m)
 {
     uint8_t expected = _Py_LOCKED;
+#ifdef PYMM_RELEASE_UNLOCK
+    /* Counterfactual: textbook spinlock unlock = a single release store (no RMW). */
+    (void)expected;
+    __atomic_store_n(&m->_bits, (uint8_t)0, __ATOMIC_RELEASE);
+#else
     if (!_Py_atomic_compare_exchange_uint8(&m->_bits, &expected, _Py_UNLOCKED)) {
         PyMutex_Unlock(m);
     }
+#endif
 }
 #define PyMutex_Unlock _PyMutex_Unlock
 
