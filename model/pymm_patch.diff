+#ifdef PYMM_RELEASE_UNLOCK
+    /* Counterfactual spinlock: never park, so _Py_HAS_PARKED is never set and the
+       release-store unlock below is a correct mutex. Detach while backing off so that
+       stop-the-world requests are not blocked (mirrors _PySemaphore_Wait). */
+    {
