C MPmix_array-now

{ x=0; y=0; mf=0; }

P0 (int* x, atomic_int* y, atomic_int* mf) {
  *x = 1;
  atomic_exchange_explicit(mf, 1, memory_order_seq_cst);
  atomic_store_explicit(y, 1, memory_order_release);
  atomic_exchange_explicit(mf, 0, memory_order_seq_cst);
}

P1 (int* x, atomic_int* y, atomic_int* mf) {
  int r0 = atomic_load_explicit(y, memory_order_seq_cst);
  int r1 = *x;
}

exists (1:r0=1 /\ 1:r1=0)
