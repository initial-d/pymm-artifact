C 2+2W+list-base

{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }

P0 (atomic_int* x, atomic_int* y, atomic_int* mx, atomic_int* my, atomic_int* ox, atomic_int* oy) {
  atomic_exchange_explicit(mx, 1, memory_order_seq_cst);
  atomic_store_explicit(x, 1, memory_order_release);
  atomic_exchange_explicit(mx, 0, memory_order_seq_cst);
  atomic_exchange_explicit(my, 1, memory_order_seq_cst);
  atomic_store_explicit(y, 2, memory_order_release);
  atomic_exchange_explicit(my, 0, memory_order_seq_cst);
}

P1 (atomic_int* x, atomic_int* y, atomic_int* mx, atomic_int* my, atomic_int* ox, atomic_int* oy) {
  atomic_exchange_explicit(my, 1, memory_order_seq_cst);
  atomic_store_explicit(y, 1, memory_order_release);
  atomic_exchange_explicit(my, 0, memory_order_seq_cst);
  atomic_exchange_explicit(mx, 1, memory_order_seq_cst);
  atomic_store_explicit(x, 2, memory_order_release);
  atomic_exchange_explicit(mx, 0, memory_order_seq_cst);
}

exists ([x]=1 /\ [y]=1)
