X86 R+global-fix2
{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }
 P0            | P1            ;
 MOV ESI,$1    | MOV ESI,$1    ;
 XCHG [mx],ESI | XCHG [my],ESI ;
 MOV EDI,$1    | MOV EDI,$2    ;
 XCHG [x],EDI  | XCHG [y],EDI  ;
 MOV ESI,$0    | MOV ESI,$0    ;
 XCHG [mx],ESI | XCHG [my],ESI ;
 MOV ESI,$1    | MOV EAX,[x]   ;
 XCHG [my],ESI |               ;
 MOV EDI,$1    |               ;
 XCHG [y],EDI  |               ;
 MOV ESI,$0    |               ;
 XCHG [my],ESI |               ;
exists ([y]=2 /\ 1:EAX=0)
