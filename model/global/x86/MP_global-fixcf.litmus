X86 MP+global-fixcf
{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }
 P0            | P1          ;
 MOV ESI,$1    | MOV EAX,[y] ;
 XCHG [mx],ESI | MOV EBX,[x] ;
 MOV EDI,$1    |             ;
 XCHG [x],EDI  |             ;
 MOV [mx],$0   |             ;
 MOV ESI,$1    |             ;
 XCHG [my],ESI |             ;
 MOV EDI,$1    |             ;
 XCHG [y],EDI  |             ;
 MOV [my],$0   |             ;
exists (1:EAX=1 /\ 1:EBX=0)
