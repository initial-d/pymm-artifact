X86 2+2W+proposed
{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }
 P0            | P1            ;
 MOV ESI,$1    | MOV ESI,$1    ;
 XCHG [mx],ESI | XCHG [my],ESI ;
 MOV EDI,$1    | MOV EDI,$1    ;
 XCHG [x],EDI  | XCHG [y],EDI  ;
 MOV [mx],$0   | MOV [my],$0   ;
 MOV ESI,$1    | MOV ESI,$1    ;
 XCHG [my],ESI | XCHG [mx],ESI ;
 MOV EDI,$2    | MOV EDI,$2    ;
 XCHG [y],EDI  | XCHG [x],EDI  ;
 MOV [my],$0   | MOV [mx],$0   ;
exists ([x]=1 /\ [y]=1)
