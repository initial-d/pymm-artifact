X86 R+attr-base
{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }
 P0            | P1            ;
 MOV ESI,$1    | MOV ESI,$1    ;
 XCHG [mx],ESI | XCHG [my],ESI ;
 MOV [x],$1    | MOV [y],$2    ;
 MOV ESI,$0    | MOV ESI,$0    ;
 XCHG [mx],ESI | XCHG [my],ESI ;
 MOV EDX,$0    | MOV EDX,$0    ;
 XCHG [ox],EDX | XCHG [oy],EDX ;
 MOV ESI,$1    | MOV EAX,[x]   ;
 XCHG [my],ESI | MOV EDX,$0    ;
 MOV [y],$1    | XCHG [ox],EDX ;
 MOV ESI,$0    |               ;
 XCHG [my],ESI |               ;
 MOV EDX,$0    |               ;
 XCHG [oy],EDX |               ;
exists ([y]=2 /\ 1:EAX=0)
