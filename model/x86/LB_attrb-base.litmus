X86 LB+attrb-base
{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }
 P0            | P1            ;
 MOV EAX,[x]   | MOV EAX,[y]   ;
 MOV ESI,$1    | MOV ESI,$1    ;
 XCHG [my],ESI | XCHG [mx],ESI ;
 MOV [y],$1    | MOV [x],$1    ;
 MOV ESI,$0    | MOV ESI,$0    ;
 XCHG [my],ESI | XCHG [mx],ESI ;
exists (0:EAX=1 /\ 1:EAX=1)
