X86 2+2W+attr-cf
{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }
 P0            | P1            ;
 MOV ESI,$1    | MOV ESI,$1    ;
 XCHG [mx],ESI | XCHG [my],ESI ;
 MOV [x],$1    | MOV [y],$1    ;
 MOV [mx],$0   | MOV [my],$0   ;
 MOV EDX,$0    | MOV EDX,$0    ;
 XCHG [ox],EDX | XCHG [oy],EDX ;
 MOV ESI,$1    | MOV ESI,$1    ;
 XCHG [my],ESI | XCHG [mx],ESI ;
 MOV [y],$2    | MOV [x],$2    ;
 MOV [my],$0   | MOV [mx],$0   ;
 MOV EDX,$0    | MOV EDX,$0    ;
 XCHG [oy],EDX | XCHG [ox],EDX ;
exists ([x]=1 /\ [y]=1)
