X86 MP+attrb-base
{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }
 P0            | P1          ;
 MOV ESI,$1    | MOV EAX,[y] ;
 XCHG [mx],ESI | MOV EBX,[x] ;
 MOV [x],$1    |             ;
 MOV ESI,$0    |             ;
 XCHG [mx],ESI |             ;
 MOV ESI,$1    |             ;
 XCHG [my],ESI |             ;
 MOV [y],$1    |             ;
 MOV ESI,$0    |             ;
 XCHG [my],ESI |             ;
exists (1:EAX=1 /\ 1:EBX=0)
