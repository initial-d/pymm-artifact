X86 MP+attr-base
{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }
 P0            | P1            ;
 MOV ESI,$1    | MOV EAX,[y]   ;
 XCHG [mx],ESI | MOV EDX,$0    ;
 MOV [x],$1    | XCHG [oy],EDX ;
 MOV ESI,$0    | MOV EBX,[x]   ;
 XCHG [mx],ESI | MOV EDX,$0    ;
 MOV EDX,$0    | XCHG [ox],EDX ;
 XCHG [ox],EDX |               ;
 MOV ESI,$1    |               ;
 XCHG [my],ESI |               ;
 MOV [y],$1    |               ;
 MOV ESI,$0    |               ;
 XCHG [my],ESI |               ;
 MOV EDX,$0    |               ;
 XCHG [oy],EDX |               ;
exists (1:EAX=1 /\ 1:EBX=0)
