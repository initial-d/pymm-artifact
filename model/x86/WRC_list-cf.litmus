X86 WRC+list-cf
{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }
 P0            | P1            | P2          ;
 MOV ESI,$1    | MOV EAX,[x]   | MOV EAX,[y] ;
 XCHG [mx],ESI | MOV ESI,$1    | MOV EBX,[x] ;
 MOV [x],$1    | XCHG [my],ESI |             ;
 MOV [mx],$0   | MOV [y],$1    |             ;
               | MOV [my],$0   |             ;
exists (1:EAX=1 /\ 2:EAX=1 /\ 2:EBX=0)
