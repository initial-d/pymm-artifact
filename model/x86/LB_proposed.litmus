X86 LB+proposed
{ x=0; y=0; mx=0; my=0; ox=0; oy=0; }
 P0            | P1            ;
 MOV EAX,[x]   | MOV EAX,[y]   ;
 MOV ESI,$1    | MOV ESI,$1    ;
 XCHG [my],ESI | XCHG [mx],ESI ;
 MOV EDI,$1    | MOV EDI,$1    ;
 XCHG [y],EDI  | XCHG [x],EDI  ;
 MOV [my],$0   | MOV [mx],$0   ;
exists (0:EAX=1 /\ 1:EAX=1)
