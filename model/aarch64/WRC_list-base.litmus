AArch64 WRC+list-base
{
0:X1=x; 0:X2=y; 0:X3=mx; 0:X4=my; 0:X5=ox; 0:X6=oy; 1:X1=x; 1:X2=y; 1:X3=mx; 1:X4=my; 1:X5=ox; 1:X6=oy; 2:X1=x; 2:X2=y; 2:X3=mx; 2:X4=my; 2:X5=ox; 2:X6=oy;
}
 P0                 | P1                 | P2            ;
 MOV W7,#0          | MOV W7,#0          | MOV W7,#0     ;
 MOV W0,#1          | LDAR W20,[X1]      | LDAR W20,[X2] ;
 MOV W11,#1         | MOV W0,#1          | LDAR W21,[X1] ;
 SWPAL W11,W12,[X3] | MOV W11,#1         |               ;
 STLR W0,[X1]       | SWPAL W11,W12,[X4] |               ;
 SWPAL W7,W12,[X3]  | STLR W0,[X2]       |               ;
                    | SWPAL W7,W12,[X4]  |               ;
exists (1:X20=1 /\ 2:X20=1 /\ 2:X21=0)
