AArch64 MP+array-now
{
0:X1=x; 0:X2=y; 0:X3=mx; 0:X4=my; 0:X5=ox; 0:X6=oy; 1:X1=x; 1:X2=y; 1:X3=mx; 1:X4=my; 1:X5=ox; 1:X6=oy;
}
 P0          | P1           ;
 MOV W7,#0   | MOV W7,#0    ;
 MOV W0,#1   | LDR W20,[X2] ;
 STR W0,[X1] | LDR W21,[X1] ;
 MOV W0,#1   |              ;
 STR W0,[X2] |              ;
exists (1:X20=1 /\ 1:X21=0)
