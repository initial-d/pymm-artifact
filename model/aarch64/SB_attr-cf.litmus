 MOV W7,#0          | MOV W7,#0          ;
 MOV W0,#1          | MOV W0,#1          ;
 MOV W11,#1         | MOV W11,#1         ;
 SWPAL W11,W12,[X3] | SWPAL W11,W12,[X4] ;
 STLR W0,[X1]       | STLR W0,[X2]       ;
 STLR W7,[X3]       | STLR W7,[X4]       ;
 MOV W8,#-1         | MOV W8,#-1         ;
 LDADDAL W8,W9,[X5] | LDADDAL W8,W9,[X6] ;
 LDAPR W20,[X2]     | LDAPR W20,[X1]     ;
 MOV W8,#-1         | MOV W8,#-1         ;
 LDADDAL W8,W9,[X6] | LDADDAL W8,W9,[X5] ;
exists (0:X20=0 /\ 1:X20=0)
