AArch64 IRIW+array-now
{
0:X1=x; 0:X2=y; 0:X3=mx; 0:X4=my; 0:X5=ox; 0:X6=oy; 1:X1=x; 1:X2=y; 1:X3=mx; 1:X4=my; 1:X5=ox; 1:X6=oy; 2:X1=x; 2:X2=y; 2:X3=mx; 2:X4=my; 2:X5=ox; 2:X6=oy; 3:X1=x; 3:X2=y; 3:X3=mx; 3:X4=my; 3:X5=ox; 3:X6=oy;
}
